    {
        "id": "c94d55ebb3d98043",
        "type": "function",
        "z": "74b807c803dade99",
        "name": "Get Latest Readings",
        "func": "let readings = [];\nconst thermometers = flow.get('thermometers') || [];\n\nif (!thermometers.length) {\n    return msg;\n}\n\nfor (let t of thermometers) {\n    const sensor = t.payload;\n    const reading = {\n        id: sensor.id,\n        name: sensor.name,\n        brand: sensor.brand,\n        model: sensor.model_id.replaceAll('/', '_'),\n        last_logged: t.lastLogged,\n        tempc: sensor.tempc,\n        tempf: sensor.tempf,\n        hum: sensor.hum,\n        batt: sensor.batt,\n        category: sensor.category,\n        house: sensor.house,\n        room: sensor.room\n    };\n    readings.push(reading);\n}\n\nmsg.payload = readings;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 420,
        "wires": [
