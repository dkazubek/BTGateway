    {
        "id": "48f2f049a70ea3da",
        "type": "function",
        "z": "74b807c803dade99",
        "name": "Add Location",
        "func": "let deviceLocations = flow.get('deviceLocations') || [];\n\nif (!deviceLocations.length) {\n    return msg;\n}\n\nconst deviceLoation = deviceLocations.find(l => l.id == msg.payload.id);\n\nif (!!deviceLoation) {\n    msg.payload.house = deviceLoation.house;\n    msg.payload.room = deviceLoation.room;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 200,
        "wires": [
            [
                "8652629ae92e2a69"
            ]
        ]
    },
    {
        "id": "a08c6d7bd80937ec",
        "type": "function",
        "z": "74b807c803dade99",
        "name": "Log Heartbeat",
        "func": "let thermometers = flow.get('thermometers') || [];\nlet found = thermometers.find(t => t.id == msg.payload.id);\n\nif (!!found) {\n    found.lastLogged = new Date().toISOString();\n    found.payload = msg.payload;\n    found.totalHits++;\n} else {\n    found = {\n        id: msg.payload.id,\n        room: msg.payload.room,\n        lastLogged: Date.UTC,\n        totalHits: 1,\n        payload: msg.payload\n    }\n\n    thermometers.push(found);\n}\n\nflow.set('thermometers', thermometers);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 320,
        "wires": [
            [
                "d00564d0547d710e"
            ]
        ]
    },
