    {
        "id": "48f2f049a70ea3da",
        "type": "function",
        "z": "74b807c803dade99",
        "name": "Add Location",
        "func": "const deviceLocations = [\n    { \"id\": \"A4:C1:38:21:C9:85\", \"house\": \"1 sayfield cottages\", \"room\": \"office\" },\n    { \"id\": \"A4:C1:38:17:06:8A\", \"house\": \"1 sayfield cottages\", \"room\": \"main bedroom\" },\n    { \"id\": \"A4:C1:38:14:B9:D7\", \"house\": \"1 sayfield cottages\", \"room\": \"playroom\" },\n    { \"id\": \"A4:C1:38:7B:29:6C\", \"house\": \"1 sayfield cottages\", \"room\": \"jan bedroom\" },\n    { \"id\": \"A4:C1:38:5B:DF:9E\", \"house\": \"1 sayfield cottages\", \"room\": \"tomek bedroom\" },\n    { \"id\": \"A4:C1:38:94:21:EC\", \"house\": \"1 sayfield cottages\", \"room\": \"workshop\" },\n    { \"id\": \"A4:C1:38:E1:1E:45\", \"house\": \"1 sayfield cottages\", \"room\": \"greenhouse\" },\n    { \"id\": \"A4:C1:38:34:70:8B\", \"house\": \"1 sayfield cottages\", \"room\": \"loft\" }\n];\n\nconst deviceLoation = deviceLocations.find(l => l.id == msg.payload.id);\n\nif (!!deviceLoation) {\n    msg.payload.house = deviceLoation.house;\n    msg.payload.room = deviceLoation.room;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
